{
  "name": "tenant-ease",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @tenantease/api --filter @tenantease/web dev",
    "dev:api": "corepack pnpm --filter @tenantease/api dev",
    "dev:web": "corepack pnpm --filter @tenantease/web dev",
    "build": "corepack pnpm -r build",
    "start": "corepack pnpm --parallel --filter @tenantease/api --filter @tenantease/web start",
    "start:api": "corepack pnpm --filter @tenantease/api start",
    "start:web": "corepack pnpm --filter @tenantease/web start",
    "lint": "corepack pnpm -r lint",
    "audit:prod": "node scripts/audit-production.mjs",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:api": "corepack pnpm --filter @tenantease/api test",
    "prisma:generate": "corepack pnpm --filter @tenantease/api prisma:generate",
    "prisma:migrate": "corepack pnpm --filter @tenantease/api prisma:migrate",
    "prisma:seed": "corepack pnpm --filter @tenantease/api prisma:seed",
    "db:studio": "corepack pnpm --filter @tenantease/api db:studio"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": ">=1.19.13",
      "hono": ">=4.12.25",
      "defu": "^6.1.5",
      "fast-uri": "^3.1.2",
      "postcss": "^8.5.10"
    }
  }
}
